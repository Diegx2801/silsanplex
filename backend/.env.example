# Copiar como backend/.env.local. Nunca versionar la clave privada real.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
PUBLIC_APP_URL=http://127.0.0.1:5173

INITIAL_ORGANIZATION_SLUG=drogueria-silsan
INITIAL_ORGANIZATION_NAME=Droguería SILSAN S.A.C.
INITIAL_ADMIN_EMAIL=admin@silsan.local
INITIAL_ADMIN_FULL_NAME=Administrador SILSAN
INITIAL_ADMIN_PHONE=
# Solo para desarrollo local. Nunca reutilizar ni desplegar esta contraseña.
INITIAL_ADMIN_PASSWORD=

# Identidades reproducibles para Playwright local. Usa contraseñas exclusivas
# de desarrollo; e2e:prepare genera frontend/.env.e2e.local, que está ignorado.
E2E_ADMIN_EMAIL=e2e.admin@silsan.local
E2E_ADMIN_PASSWORD=
E2E_MEMBER_EMAIL=e2e.ventas@silsan.local
E2E_MEMBER_PASSWORD=
E2E_RECOVERY_EMAIL=e2e.recuperacion@silsan.local
E2E_RECOVERY_PASSWORD=
