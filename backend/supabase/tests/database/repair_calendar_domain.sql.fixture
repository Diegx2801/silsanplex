\ir s01_auth_session_fixture.inc
-- Actual public commands under an authenticated session; all data is rolled back.
create temporary table d06_ids(label text primary key, id uuid not null default gen_random_uuid());
insert into d06_ids(label) values ('org'),('foreign-org'),('admin'),('finance'),('foreign'),('supplier'),('product'),('undated-product');
create function pg_temp.d06_id(text) returns uuid language sql stable as $$ select id from d06_ids where label=$1 $$;
grant select on d06_ids to authenticated;
insert into organizations(id,name,slug) select id,'D06 disposable fixture','d06-'||id from d06_ids where label in ('org','foreign-org');
insert into auth.users(id,email,raw_user_meta_data) select id,id||'@example.invalid',jsonb_build_object('full_name','D06 '||label)
from d06_ids where label in ('admin','finance','foreign');
insert into auth.sessions(id,user_id,created_at,updated_at) select id,id,now(),now() from d06_ids where label in ('admin','finance','foreign');
insert into organization_memberships(organization_id,user_id) select pg_temp.d06_id(case when label='foreign' then 'foreign-org' else 'org' end),id
from d06_ids where label in ('admin','finance','foreign');
insert into user_roles(organization_id,user_id,role_code) select pg_temp.d06_id(case when label='foreign' then 'foreign-org' else 'org' end),id,
case when label='finance' then 'VENTAS' else 'ADMIN' end from d06_ids where label in ('admin','finance','foreign');
insert into organization_user_permissions(organization_id,user_id,permission_code)
select pg_temp.d06_id('org'),pg_temp.d06_id('finance'),p from unnest(array['REPAIRS_MANAGE_ACTUAL_COST','REPAIRS_CONFIRM_ACTUAL_COST']) p;
create function pg_temp.d06_claim(who text) returns text language sql as $$select pg_temp.s01_set_authenticated_claims(jsonb_build_object(
 'role','authenticated','sub',pg_temp.d06_id(who),'session_id',pg_temp.d06_id(who),'exp',extract(epoch from now()+interval '1 hour')::bigint)::text,true)$$;
insert into products(id,organization_id,code,description,unit_of_measure,product_type,tax_affectation,batch_control,expiration_control,created_by,updated_by)
select id,pg_temp.d06_id('org'),'D06-'||upper(label),'D06 fixture '||label,'UND','good','gravado',true,label='product',pg_temp.d06_id('admin'),pg_temp.d06_id('admin')
from d06_ids where label in ('product','undated-product');
insert into suppliers(id,organization_id,document_type,document_number,business_name,created_by,updated_by)
values(pg_temp.d06_id('supplier'),pg_temp.d06_id('org'),'otro','D06-SUPPLIER','D06 supplier',pg_temp.d06_id('admin'),pg_temp.d06_id('admin'));
create temporary table d06_context(warehouse uuid,location uuid);
create temporary table d06_orders(label text primary key,repair uuid not null,part uuid);
grant select,insert,update on d06_context,d06_orders to authenticated;
select pg_temp.d06_claim('admin');
set local role authenticated;
insert into d06_context(warehouse) select save_warehouse(jsonb_build_object('organization_id',pg_temp.d06_id('org'),'operation_key',gen_random_uuid(),
 'code','D06','name','D06 warehouse','address','Disposable calendar fixture'));
update d06_context set location=(select id from warehouse_locations where warehouse_id=d06_context.warehouse and code='GENERAL');
reset role;
create function pg_temp.d06_repair(label text) returns uuid language plpgsql as $$declare r uuid;begin
 r:=create_repair(jsonb_build_object('organization_id',pg_temp.d06_id('org'),'operation_key',gen_random_uuid(),
 'requester_type','internal','requesting_area','D06 laboratory','equipment_type','external','external_equipment_description','D06 equipment',
 'received_at','2026-11-01T12:00:00Z','problem_description','D06 calendar test'));
 perform assign_repair(pg_temp.d06_id('org'),r,pg_temp.d06_id('admin'),1);
 perform change_repair_status(pg_temp.d06_id('org'),r,'diagnosis',null,2);
 perform change_repair_status(pg_temp.d06_id('org'),r,'in_repair',null,3);
 insert into d06_orders values(label,r,null); return r;
end$$;
create function pg_temp.d06_reserve(label text,lot text,expiry date,quantity numeric default 2,product_label text default 'product') returns uuid
language plpgsql as $$declare r uuid;v bigint;p uuid;begin
 select repair into r from d06_orders where d06_orders.label=$1;
 select lock_version into v from repairs where id=r;
 p:=reserve_repair_part(jsonb_build_object('organization_id',pg_temp.d06_id('org'),'repair_id',r,'operation_key',gen_random_uuid(),'expected_lock_version',v,
 'product_id',pg_temp.d06_id(product_label),'warehouse_id',(select warehouse from d06_context),'location_id',(select location from d06_context),
 'stock_status','available','lot',$2,'expiration_date',$3,'quantity_requested',$4));
 update d06_orders set part=p where d06_orders.label=$1;return p;
end$$;
create function pg_temp.d06_consume(label text,quantity numeric default 1,key uuid default gen_random_uuid()) returns uuid
language plpgsql as $$declare p uuid;v bigint;begin
 select d.part,r.lock_version into p,v from d06_orders d join repairs r on r.id=d.repair where d.label=$1;
 return consume_repair_part(jsonb_build_object('organization_id',pg_temp.d06_id('org'),'repair_part_id',p,'expected_lock_version',v,'operation_key',$3,'quantity',$2));
end$$;
create function pg_temp.d06_purchase(lot text,expiry date,quantity numeric default 10,cost numeric default 7.1234,product_label text default 'product') returns uuid
language plpgsql as $$declare po uuid;item uuid;begin
 po:=save_purchase_order(jsonb_build_object('organization_id',pg_temp.d06_id('org'),'supplier_id',pg_temp.d06_id('supplier'),'document_type','factura',
 'series','D06','document_number',substr(gen_random_uuid()::text,1,8),'issue_date','2026-11-01','warehouse_id',(select warehouse from d06_context),
 'warehouse','D06 warehouse','currency','USD','prices_include_tax',false,'items',jsonb_build_array(jsonb_build_object('product_id',pg_temp.d06_id(product_label),'quantity',$3,'unit_cost',$4,'lot',$1,'expiration_date',$2))));
 perform issue_purchase_order(pg_temp.d06_id('org'),po);
 select id into item from purchase_order_items where purchase_order_id=po;
 perform receive_purchase_order_partial_inspected(jsonb_build_object('organization_id',pg_temp.d06_id('org'),'purchase_order_id',po,'operation_key',gen_random_uuid(),
 'items',jsonb_build_array(jsonb_build_object('purchase_order_item_id',item,'quantity',$3,'location_id',(select location from d06_context),
 'fulfillment_mode','physical','lot',$1,'expiration_date',$2))));return po;
end$$;
select pg_temp.d06_claim('admin');
set local role authenticated;
